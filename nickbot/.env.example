# ── Обязательно ──────────────────────────────────────────────────────────────
# Токен от @BotFather (команда /newbot)
BOT_TOKEN=1234567890:AAAA-your-token-here

# ── ИИ-подбор (необязательно) ───────────────────────────────────────────────
# Ключ Claude API: https://console.anthropic.com → API Keys. Без него /ai выключен.
ANTHROPIC_API_KEY=
# Модель и «глубина размышлений» (low | medium | high)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Сколько ИИ-запросов в день можно одному пользователю
AI_DAILY_LIMIT=20
# Кому можно пользоваться ИИ: Telegram ID через запятую. Пусто — всем
AI_ALLOWED_USERS=

# ── Точная проверка ников (необязательно) ───────────────────────────────────
# С https://my.telegram.org → API development tools. Потом один раз: python login.py
TG_API_ID=
TG_API_HASH=
